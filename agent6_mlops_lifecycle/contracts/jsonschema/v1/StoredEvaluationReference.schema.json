{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "dataset_ref": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Dataset Ref",
      "type": "string"
    },
    "evidence_ref": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Evidence Ref",
      "type": "string"
    },
    "model_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Model Id",
      "type": "string"
    },
    "model_version": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Model Version",
      "type": "string"
    },
    "policy_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Fingerprint",
      "type": "string"
    },
    "policy_version": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Policy Version",
      "type": "string"
    },
    "project_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    },
    "window_end": {
      "format": "date-time",
      "title": "Window End",
      "type": "string"
    },
    "window_start": {
      "format": "date-time",
      "title": "Window Start",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "project_id",
    "model_id",
    "model_version",
    "policy_version",
    "policy_fingerprint",
    "dataset_ref",
    "window_start",
    "window_end",
    "evidence_ref"
  ],
  "title": "StoredEvaluationReference",
  "type": "object"
}

{
  "$defs": {
    "MetricBaseline": {
      "additionalProperties": false,
      "properties": {
        "evidence_ref": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Evidence Ref",
          "type": "string"
        },
        "max_degradation": {
          "minimum": 0,
          "title": "Max Degradation",
          "type": "number"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "evidence_ref",
        "max_degradation"
      ],
      "title": "MetricBaseline",
      "type": "object"
    },
    "MetricGate": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "anyOf": [
            {
              "$ref": "#/$defs/MetricBaseline"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metric_id": {
          "maxLength": 160,
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+\\.v[1-9][0-9]*$",
          "title": "Metric Id",
          "type": "string"
        },
        "operator": {
          "$ref": "#/$defs/MetricOperator"
        },
        "threshold": {
          "title": "Threshold",
          "type": "number"
        }
      },
      "required": [
        "metric_id",
        "operator",
        "threshold"
      ],
      "title": "MetricGate",
      "type": "object"
    },
    "MetricOperator": {
      "enum": [
        "gte",
        "lte"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "gates": {
      "items": {
        "$ref": "#/$defs/MetricGate"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Gates",
      "type": "array"
    },
    "max_evidence_age_seconds": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Evidence Age Seconds"
    },
    "min_negative_samples": {
      "default": 0,
      "minimum": 0,
      "title": "Min Negative Samples",
      "type": "integer"
    },
    "min_outcome_coverage": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Min Outcome Coverage"
    },
    "min_positive_samples": {
      "default": 0,
      "minimum": 0,
      "title": "Min Positive Samples",
      "type": "integer"
    },
    "schema_version": {
      "const": "2",
      "default": "2",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "gates"
  ],
  "title": "MetricEvaluationPolicy",
  "type": "object"
}

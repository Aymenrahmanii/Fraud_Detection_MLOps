{
  "$defs": {
    "MetricBaseline": {
      "additionalProperties": false,
      "properties": {
        "evidence_ref": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Evidence Ref",
          "type": "string"
        },
        "max_degradation": {
          "minimum": 0,
          "title": "Max Degradation",
          "type": "number"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "evidence_ref",
        "max_degradation"
      ],
      "title": "MetricBaseline",
      "type": "object"
    },
    "MetricGate": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "anyOf": [
            {
              "$ref": "#/$defs/MetricBaseline"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metric_id": {
          "maxLength": 160,
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+\\.v[1-9][0-9]*$",
          "title": "Metric Id",
          "type": "string"
        },
        "operator": {
          "$ref": "#/$defs/MetricOperator"
        },
        "threshold": {
          "title": "Threshold",
          "type": "number"
        }
      },
      "required": [
        "metric_id",
        "operator",
        "threshold"
      ],
      "title": "MetricGate",
      "type": "object"
    },
    "MetricGateResult": {
      "additionalProperties": false,
      "properties": {
        "degradation": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Degradation"
        },
        "gate": {
          "$ref": "#/$defs/MetricGate"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "UNAVAILABLE"
          ],
          "title": "Status",
          "type": "string"
        },
        "unavailable_reason": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unavailable Reason"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "gate",
        "value",
        "status"
      ],
      "title": "MetricGateResult",
      "type": "object"
    },
    "MetricOperator": {
      "enum": [
        "gte",
        "lte"
      ],
      "type": "string"
    },
    "TaskType": {
      "enum": [
        "binary_classification",
        "regression",
        "text_generation",
        "custom"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "dataset_ref": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Dataset Ref",
      "type": "string"
    },
    "decision": {
      "enum": [
        "PASS",
        "FAIL",
        "INSUFFICIENT_EVIDENCE",
        "REVIEW_REQUIRED"
      ],
      "title": "Decision",
      "type": "string"
    },
    "evaluated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evaluated At"
    },
    "evaluator_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Evaluator Id",
      "type": "string"
    },
    "evaluator_model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evaluator Model"
    },
    "evidence_age_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Age Seconds"
    },
    "evidence_ref": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Evidence Ref",
      "type": "string"
    },
    "gate_results": {
      "default": [],
      "items": {
        "$ref": "#/$defs/MetricGateResult"
      },
      "maxItems": 32,
      "title": "Gate Results",
      "type": "array"
    },
    "metric_policy_version": {
      "anyOf": [
        {
          "const": "2",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Metric Policy Version"
    },
    "metrics": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Metrics",
      "type": "object"
    },
    "model_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Model Id",
      "type": "string"
    },
    "model_version": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Model Version",
      "type": "string"
    },
    "outcome_coverage": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Outcome Coverage"
    },
    "policy_version": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Policy Version",
      "type": "string"
    },
    "project_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "rationale_summary": {
      "minLength": 1,
      "title": "Rationale Summary",
      "type": "string"
    },
    "requires_human_review": {
      "title": "Requires Human Review",
      "type": "boolean"
    },
    "sample_count": {
      "minimum": 1,
      "title": "Sample Count",
      "type": "integer"
    },
    "task_type": {
      "$ref": "#/$defs/TaskType"
    }
  },
  "required": [
    "project_id",
    "model_id",
    "model_version",
    "task_type",
    "evaluator_id",
    "policy_version",
    "dataset_ref",
    "evidence_ref",
    "sample_count",
    "decision",
    "metrics",
    "rationale_summary",
    "requires_human_review"
  ],
  "title": "ProjectEvaluationReport",
  "type": "object"
}

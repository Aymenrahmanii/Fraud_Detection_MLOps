{
  "$defs": {
    "ObservationTaskType": {
      "enum": [
        "binary_classification",
        "regression"
      ],
      "type": "string"
    },
    "ObservationValue": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "number"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "task_type": {
            "const": "binary_classification"
          }
        },
        "required": [
          "task_type"
        ]
      },
      "then": {
        "properties": {
          "actual": {
            "enum": [
              0,
              1
            ],
            "type": "integer"
          }
        }
      }
    }
  ],
  "description": "confirmed_at is when a trusted source made the actual outcome available.",
  "properties": {
    "actual": {
      "$ref": "#/$defs/ObservationValue"
    },
    "confirmed_at": {
      "format": "date-time",
      "title": "Confirmed At",
      "type": "string"
    },
    "model_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Model Id",
      "type": "string"
    },
    "model_version": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Model Version",
      "type": "string"
    },
    "observation_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Observation Id",
      "type": "string"
    },
    "project_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_ref": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Source Ref",
      "type": "string"
    },
    "task_type": {
      "$ref": "#/$defs/ObservationTaskType"
    },
    "tenant_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "project_id",
    "model_id",
    "model_version",
    "task_type",
    "observation_id",
    "source_ref",
    "confirmed_at",
    "actual"
  ],
  "title": "OutcomeRecord",
  "type": "object"
}

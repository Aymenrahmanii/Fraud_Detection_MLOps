# Agent 6 owns this environment; copy to .env and keep it private.
GROQ_API_KEY=
AGENT6_MONITOR_ADVISOR_ENABLED=true
AGENT6_MONITOR_ADVISOR_MODEL=openai/gpt-oss-20b
AGENT6_MONITOR_ADVISOR_INTERVAL_SECONDS=900
# Generated by `agent6 run`; never paste these into source or reports.
AGENT6_MONITOR_TOKEN=
AGENT6_MONITOR_OUTCOME_TOKEN=
AGENT6_LIFECYCLE_INTEGRATION_TOKEN=
AGENT6_LIFECYCLE_ENABLED=true
AGENT6_LIFECYCLE_MIN_VERIFIED_LABELS=100
AGENT6_LIFECYCLE_MIN_CLASS_SAMPLES=20
AGENT6_LIFECYCLE_MAX_JOBS_PER_DAY=2
AGENT6_LIFECYCLE_COOLDOWN_HOURS=24
# High-impact exception only: routine work never needs a review.
# Enable auto promotion only after business calibration and deployment-agent acceptance.
AGENT6_LIFECYCLE_AUTO_PROMOTE=false
AGENT6_LIFECYCLE_POLICY_CALIBRATED=false

# Final verified business events: use the same allowlist for database readers and API publishers.
AGENT6_MONITOR_BUSINESS_SOURCE_IDS=["business-service"]
AGENT6_BUSINESS_SOURCE_IDS=business-service
AGENT6_MONITOR_BUSINESS_FEED_MODE=observation
# Native run uses the local verified-outcome view unless an external URL is configured.
# For an external business event view, set feed mode=transaction and configure URL/table/mapping.
# AGENT6_MONITOR_BUSINESS_DATABASE_URL=sqlite:///path/to/business.sqlite3
# AGENT6_MONITOR_BUSINESS_OUTCOME_TABLE=verified_transaction_events

# Fraud-specific live evaluation: probabilities are recorded automatically by API and Streamlit.
AGENT6_FRAUD_MIN_LABELS=30
AGENT6_FRAUD_MIN_POSITIVE_LABELS=5
AGENT6_FRAUD_MIN_NEGATIVE_LABELS=5
AGENT6_FRAUD_MIN_RECALL=0.90
AGENT6_FRAUD_MAX_FALSE_POSITIVE_RATE=0.05
AGENT6_FRAUD_MIN_PROBABILITY_LABELS=30
AGENT6_FRAUD_MIN_PROBABILITY_COVERAGE=0.9
# Costs remain UNKNOWN unless BOTH are explicitly configured. Examples only, calibrate first:
# AGENT6_FRAUD_FALSE_NEGATIVE_COST=100
# AGENT6_FRAUD_FALSE_POSITIVE_COST=2
# AGENT6_FRAUD_COST_UNIT=EUR
# AGENT6_FRAUD_MAX_COST_PER_1000=1000
# AGENT6_FRAUD_MIN_AVERAGE_PRECISION=0.8

# Copy to API/telemetry/.env for this application's prediction producer.
# Relative database paths resolve from the fraud repository root.
AGENT6_PREDICTION_DATABASE=artifacts/application.sqlite3
AGENT6_TENANT_ID=local-fraud
AGENT6_PROJECT_ID=fraud-detection-serving
AGENT6_MODEL_ID=fraud-api-pipeline

# Only a trusted outcome-producing system receives this credential. Never expose in the UI.
AGENT6_OUTCOME_SERVICE_TOKEN=
AGENT6_BUSINESS_SOURCE_IDS=business-service

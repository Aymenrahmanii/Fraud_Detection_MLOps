{
  "uid": "aiops-platform",
  "title": "AIOps platform - latency, performance, reliability",
  "schemaVersion": 39,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "tags": [
    "aiops",
    "v5-section-18"

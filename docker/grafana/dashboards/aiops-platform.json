  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Workflows finished by outcome",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "aiops-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "aiops-prom"
          },
          "expr": "sum by (kind, stage) (aiops_workflows_finished_total)",
          "legendFormat": "{{kind}} {{stage}}"
        }
      ]
    },
    {

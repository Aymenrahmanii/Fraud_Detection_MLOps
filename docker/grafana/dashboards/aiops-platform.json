    {
      "id": 4,
      "type": "timeseries",
      "title": "MTTR - workflow duration p50 / p95",
      "description": "p95 needs several events in the window; the 'avg' series is the mean since the process started.",
      "datasource": {
        "type": "prometheus",
        "uid": "aiops-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "aiops-prom"
          },
          "expr": "histogram_quantile(0.5, sum by (le, kind) (rate(aiops_workflow_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 {{kind}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "aiops-prom"
          },
          "expr": "histogram_quantile(0.95, sum by (le, kind) (rate(aiops_workflow_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{kind}}"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "aiops-prom"
          },
          "expr": "sum by (kind) (aiops_workflow_duration_seconds_sum) / sum by (kind) (aiops_workflow_duration_seconds_count)",
          "legendFormat": "avg since start {{kind}}"
        }
      ]
    },
    {
